{
  "manifest_version": 3,
  "name": "HCR Browser Companion",
  "version": "0.1.0",
  "description": "Optional Browser Companion for Heisenberg Coder Router. Sends Web Handoff tasks to ChatGPT Web and returns the response to local HCR only.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:7876/*", "https://chatgpt.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HCR Browser Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
