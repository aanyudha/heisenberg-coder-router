{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@heisenberg/contracts": ["packages/contracts/src/index.ts"],
      "@heisenberg/shared": ["packages/shared/src/index.ts"],
      "@heisenberg/providers": ["packages/providers/src/index.ts"],
      "@heisenberg/core": ["packages/core/src/index.ts"]
    },
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true
  },
  "exclude": ["node_modules", "dist"]
}
